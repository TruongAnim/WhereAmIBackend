{
  "name": "whereami-functions",
  "version": "1.0.0",
  "description": "HTTP ingest adapter that stores Traccar Client SDK positions in Firestore",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && node --test lib/",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "logs": "firebase functions:log --only ingest",
    "deploy": "firebase deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
