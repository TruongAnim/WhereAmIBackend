rules_version = '2';

// Every write arrives through the `ingest` Cloud Function, which uses the
// Admin SDK and bypasses these rules entirely. No client - web, mobile or
// REST - may touch the data directly.
//
// If the app later needs to read history back, add a narrowly scoped
// `allow read` here guarded by request.auth.uid instead of loosening this.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
